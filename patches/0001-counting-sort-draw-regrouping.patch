+    /// Stably sorts `self.runs` by `key` into `self.runs_out`, then swaps.
+    ///
+    /// `sort_by_key` is a stable merge sort, so it allocates an `n / 2` buffer
+    /// on every call. The key is `band << 32 | page` and the key space is tiny
+    /// (a few dozen bands by a few pages), so a stable counting sort does the
+    /// same thing in O(n) with no allocation. Stable by construction: entries
+    /// are placed into bucket cursors in input order.
+    ///
+    /// Returns false when the input is not the shape `push` guarantees, leaving
+    /// `self.runs` untouched for the caller to sort the old way.
+    fn counting_sort(&mut self) -> bool {
+        self.pages_seen.clear();
+        self.bands.clear();
+        let mut last_band = None;
+        for r in &self.runs {
+            let (band, p) = (r.key >> 32, r.key as u32);
+            match last_band {
+                Some(prev) if band < prev => return false,
+                Some(prev) if band == prev => {}
+                _ => {
+                    self.bands.push(band);
+                    last_band = Some(band);
+                }
+            }
+            if !self.pages_seen.contains(&p) {
+                self.pages_seen.push(p);
+                if self.pages_seen.len() > MAX_PAGES {
+                    return false;
+                }
+            }
+        }
+        let keys = self.bands.len() * self.pages_seen.len();
+        if keys == 0 || keys > MAX_KEYS {
+            return false;
+        }
+        self.pages_seen.sort_unstable();
+
+        let np = self.pages_seen.len();
+        self.key_of_run.clear();
+        self.key_of_run.reserve(self.runs.len());
+        let mut band_index = 0usize;
+        let mut prev_band = u64::MAX;
+        for r in &self.runs {
+            let band = r.key >> 32;
+            if band != prev_band {
+                band_index = match self.bands.binary_search(&band) {
+                    Ok(i) => i,
+                    Err(_) => return false,
+                };
+                prev_band = band;
+            }
+            let Ok(page_index) = self.pages_seen.binary_search(&(r.key as u32)) else {
+                return false;
+            };
+            self.key_of_run.push((band_index * np + page_index) as u32);
+        }
+
+        self.offsets.clear();
+        self.offsets.resize(keys, 0);
+        for &key in &self.key_of_run {
+            self.offsets[key as usize] += 1;
+        }
+        let mut acc = 0u32;
+        for offset in &mut self.offsets {
+            let n = *offset;
+            *offset = acc;
+            acc += n;
+        }
+        // `Run` has no `Default`; any run serves as the filler, since every
+        // slot is overwritten below.
+        let fill = self.runs[0];
+        self.runs_out.clear();
+        self.runs_out.resize(self.runs.len(), fill);
+        for (i, &key) in self.key_of_run.iter().enumerate() {
+            let slot = &mut self.offsets[key as usize];
+            let at = *slot as usize;
+            *slot += 1;
+            self.runs_out[at] = self.runs[i];
+        }
+        std::mem::swap(&mut self.runs, &mut self.runs_out);
+        true
+    }
 }
 
